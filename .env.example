# Backend API URL
VITE_API_URL=http://localhost:3001/api

# Enable usage statistics panel (development mode)
# Set to 'true' to show token tracking UI in bottom-right corner
VITE_SHOW_USAGE_STATS=true

# =============================================================================
# Firebase Configuration (Optional - enables cloud save features)
# =============================================================================
# Get these values from your Firebase project:
# https://console.firebase.google.com/project/_/settings/general/
#
# VITE_FIREBASE_API_KEY=your-api-key
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project-id
# VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
# VITE_FIREBASE_APP_ID=your-app-id
#
# Without these, the app works normally with localStorage only.
# With these configured, users can sign in and save projects to the cloud.
